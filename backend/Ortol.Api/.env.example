# Copia questo file in ".env" (stessa cartella) e imposta le credenziali.
# Al PRIMO avvio, se non esiste ancora nessun utente, Ortol crea questo amministratore.
# La password viene salvata solo come hash in App_Data/users.json: dopo il primo avvio
# questo valore non viene più usato e la password si cambia dall'app (menu utente → Cambia password).
ORTOL_ADMIN_USERNAME=admin
ORTOL_ADMIN_DISPLAYNAME=Amministratore
ORTOL_ADMIN_PASSWORD=cambia-questa-password
